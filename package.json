{
  "name": "wardens",
  "private": true,
  "type": "module",
  "scripts": {
    "sim": "wasm-pack build crates/sim-wasm --target web --out-dir ../../web/src/sim-pkg --release",
    "dev": "vite web",
    "dev:https": "WARDENS_HTTPS=1 vite web",
    "build": "npm run sim && npm run typecheck && vite build web",
    "typecheck": "tsc -p web && tsc -p web/tsconfig.node.json && tsc -p tools",
    "test": "cargo test && npm run test:wasm",
    "test:wasm": "wasm-pack test --node crates/sim-wasm",
    "voice-eval": "node --disable-warning=ExperimentalWarning tools/voice-eval/main.ts",
    "say": "node --disable-warning=ExperimentalWarning tools/say/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
