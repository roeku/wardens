# Voice serving (docs/spec/06-voice.md §2). Copy to .env at the repo root; the dev server (web/vite.config.ts) reads
# it in Node and never sends a key to the browser. Every line is optional.

# The local brain: llama-server started by scripts/brain.sh.
BRAIN_URL=http://127.0.0.1:8080

# The hosted copy of the same Glimmer weights (Modal or Baseten, running llama-server), for ?brain=hosted and as the
# local brain's fallback. Proxied at /brain-hosted with the key as a bearer token.
HOSTED_BRAIN_URL=
HOSTED_BRAIN_KEY=

# Speech-to-text: local (whisper.cpp) or meta (Muse Voice Transcribe). Meta is the default once META_API_KEY is set;
# it falls back to local on any failure.
STT_ENGINE=
META_API_KEY=
META_STT_URL=
META_STT_MODEL=muse-voice-transcribe

# whisper.cpp: the model, the port whisper-server is started on, and the binaries.
WHISPER_MODEL=
WHISPER_PORT=8178
WHISPER_SERVER=whisper-server
WHISPER_CLI=whisper-cli
